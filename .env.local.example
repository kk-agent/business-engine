# Business Engine - Environment Configuration
# Copy this file to .env.local and fill in your values

# Anthropic API Key (required for Claude-powered features)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Override Claude model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Application Configuration
NODE_ENV=development
PORT=3000

# Pro license key (set on Vercel; customers send via x-be-license header)
# BUSINESS_ENGINE_PRO_KEY=

# Free tier ingest limit per IP per month (default 5)
# FREE_INGEST_LIMIT=5

# Optional: Upstash Redis for persistent knowledge graph + usage quotas
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Enable debug logging
# DEBUG=true
